# nav.fun — security headers + SPA routing
# Managed file: edit site/public/.htaccess, rebuild, redeploy. Do not hand-edit on the host.
# Addresses v6 campaign findings FP-M02 (framable), FP-M03 (inert CSP), FP-L06/FP-I04 (missing headers).

<IfModule mod_headers.c>
  # ── FP-M02: clickjacking / wallet-drainer framing ────────────────────────────
  # The dapp previously rendered in full inside a cross-origin iframe, including a
  # working CONNECT WALLET button. Deny framing outright — nav.fun is never embedded.
  Header always set X-Frame-Options "DENY"

  # ── FP-M03: real Content-Security-Policy ────────────────────────────────────
  # Replaces the inert `upgrade-insecure-requests`-only policy. Origins below are
  # derived from an audit of every https:// literal in src/ and the built bundle.
  #
  #  script-src  'self' only — no CDN scripts are loaded; blocks injected remote JS.
  #              'wasm-unsafe-eval' is required by wallet SDK crypto paths.
  #  style-src   needs 'unsafe-inline' (styled JSX / inline critical CSS) + font CDNs.
  #  connect-src pinned to our RPC, the explorer and wallet transports — this is the
  #              exfiltration backstop: injected code cannot POST data elsewhere.
  #  img-src     allows data: (the inline SVG favicon and EIP-6963 wallet icons).
  #  frame-ancestors 'none' is the modern equivalent of X-Frame-Options: DENY.
  #  object-src / base-uri closed to kill plugin and <base> hijack vectors.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' data: https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://rpc.mainnet.chain.robinhood.com https://robinhoodchain.blockscout.com https://api.fontshare.com https://fonts.googleapis.com https://fonts.gstatic.com https://rpc.wallet.coinbase.com https://www.walletlink.org https://4byte.sourcify.dev; frame-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # ── FP-L06 / FP-I04: transport and sniffing hardening ───────────────────────
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # No camera/mic/geolocation/payment use anywhere in the dapp.
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# ── FP-I04: serve JS with the correct type so nosniff cannot break the app ────
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# ── Immutable caching for content-hashed assets; never cache the shell ────────
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── FP-I03: unknown paths served a foreign parked template. Route them to our
#    own shell instead. The app uses a HashRouter, so index.html handles the rest.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Never serve source maps or dotfiles in production
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Host-side page cache: deploys must go live immediately ────────────────────
# Every asset filename is content-hashed, so index.html is the only mutable
# file. The host's LiteSpeed page cache was observed serving a stale copy of
# it after a deploy (Last-Modified frozen pre-push). Disable page-cache lookup
# and pin no-store on HTML — hashed assets stay long-cached by the browser.
<IfModule LiteSpeed>
  CacheLookup off
  CacheDisable public /
</IfModule>
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </IfModule>
</FilesMatch>
# Vite content-hashes every .js/.css filename, so these are immutable forever.
<FilesMatch "\.(js|css)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>
